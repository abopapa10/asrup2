# Google Search Console — Mülkiyet doğrulama (HTML etiketi yöntemi)
# Search Console → Ayarlar → Mülkiyet doğrulama → HTML etiketi
# content="..." içindeki değeri buraya yapıştırın (tırnak işareti olmadan)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Ads — gtag (opsiyonel; boşsa etiket yüklenmez)
# Ads → Hedefler → Dönüşümler → etiket kurulumu
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Dönüşüm send_to: AW-XXXXXXX/YYYYYYYY (WhatsApp tıklama)
NEXT_PUBLIC_GOOGLE_ADS_WA_SEND_TO=
